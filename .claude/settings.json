{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make test-all)",
      "Bash(make check-wasm)",
      "Bash(make help-cli)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo nextest run:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fmt --check:*)",
      "Bash(python3 .agents/skills/planning/scripts/validate_wiki.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(git push:*)"
    ]
  }
}
