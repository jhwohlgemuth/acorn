ARG RUST_VERSION=1.96.0
ARG BUF_VERSION=1.73.0
ARG NIGHTLY_TOOLCHAIN=nightly-2026-08-01
ARG DOCKER_HUB_REGISTRY=docker.io/library
FROM ${DOCKER_HUB_REGISTRY}/rust:${RUST_VERSION}-slim
ARG NIGHTLY_TOOLCHAIN
#
# %labels
#
LABEL author="Jason Wohlgemuth"
#
# %arguments
#
ARG DEBIAN_FRONTEND=noninteractive
ARG BUF_VERSION
ARG TARGETARCH
#
# %environment
#
ENV MUSL_BUILD="cargo zigbuild"
ENV PATH="/opt/zigbuild/bin:/root/.cargo/bin:${PATH}"
#
# %post
#
COPY scripts/install-zigbuild.sh /usr/local/bin/install-zigbuild
RUN case "${TARGETARCH}" in \
        amd64) powershell_arch=x64 ;; \
        arm64) powershell_arch=arm64 ;; \
        *) echo "Unsupported PowerShell architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && apt-get update && apt-get install --no-install-recommends --yes \
        ca-certificates \
        clang \
        curl \
        git \
        gnupg \
        libssl-dev \
        make \
        mingw-w64 \
        musl-tools \
        pkg-config \
        shellcheck \
        xz-utils \
    && apt-get install --no-install-recommends --yes \
        npm \
    && sh /usr/local/bin/install-zigbuild /opt/zigbuild \
    && npx playwright install-deps \
    && curl -fkL -o /tmp/powershell.tar.gz "https://github.com/PowerShell/PowerShell/releases/download/v7.4.6/powershell-7.4.6-linux-${powershell_arch}.tar.gz" \
    && mkdir -p /opt/microsoft/powershell/7 \
    && tar zxf /tmp/powershell.tar.gz -C /opt/microsoft/powershell/7 \
    && chmod +x /opt/microsoft/powershell/7/pwsh \
    && ln -s /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh \
    && rm -f /tmp/powershell.tar.gz \
    && curl -fsSL "https://github.com/bufbuild/buf/releases/download/v${BUF_VERSION}/buf-Linux-$(uname -m)" -o /usr/local/bin/buf \
    && chmod +x /usr/local/bin/buf \
    && buf --version \
    && rustup toolchain install stable --profile minimal \
        --component clippy \
        --component rust-analyzer \
        --component rustfmt \
        --target wasm32-unknown-unknown \
        --target x86_64-pc-windows-gnu \
        --target x86_64-unknown-linux-musl \
    && rustup toolchain install "${NIGHTLY_TOOLCHAIN}" --profile minimal \
    && cargo install --locked cargo-fuzz --version 0.13.1 \
    && cargo install --locked cargo-shear --version 1.14.0 \
    && cargo install --locked mdbook --version 0.5.2 \
    && cargo install --locked mdbook-mermaid --version 0.17.0 \
    && cargo install --locked mdbook-pikchr --version 0.2.0 \
    && cargo install --locked sqruff --version 0.40.0 \
    && cargo install --locked wasm-pack --version 0.15.0 \
    && apt-get clean \
    && rm -rf /tmp/* /var/lib/apt/lists/* /var/tmp/* \
    && rm -rf /usr/share/man/?? \
    && rm -rf /usr/share/man/??_*
HEALTHCHECK NONE
RUN mkdir -p /tmp/build-playwright-rust \
    && curl -kL --retry 3 -o /tmp/build-playwright-rust/driver.zip \
         "https://playwright.azureedge.net/builds/driver/next/playwright-1.11.0-1620331022000-linux.zip"
CMD ["/bin/bash"]
