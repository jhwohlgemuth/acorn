{
  "brandColor": "#8C6CFF",
  "connectionReferences": {},
  "connectorDisplayName": "Control",
  "id": "b0983784-10fb-4bc8-9de7-98771314a1df",
  "isTrigger": false,
  "operationName": "Validate_and_claim_receipt",
  "operationDefinition": {
    "type": "Scope",
    "actions": {
      "Validate_delivery": {
        "type": "ParseJson",
        "inputs": {
          "content": "@string(createArray(triggerBody()?['text']))",
          "schema": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        },
        "runAfter": {}
      },
      "Validate_event": {
        "type": "ParseJson",
        "inputs": {
          "content": "@triggerBody()?['text_1']",
          "schema": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "description": "Current ArtifactEvent wire shape. webhook-id is a request header, not a body field.",
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "event": {
                    "enum": [
                      "artifact-ready"
                    ],
                    "type": "string"
                  },
                  "checksum": {
                    "type": "string"
                  },
                  "package_url": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": "string"
                  },
                  "through": {
                    "type": "string"
                  }
                },
                "required": [
                  "event",
                  "checksum",
                  "package_url",
                  "project_id",
                  "through"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "event": {
                    "enum": [
                      "failed"
                    ],
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "event",
                  "message",
                  "project_id"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "event": {
                    "enum": [
                      "mr-created"
                    ],
                    "type": "string"
                  },
                  "merge_request_url": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "event",
                  "merge_request_url",
                  "project_id"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "event": {
                    "enum": [
                      "report-no-changes"
                    ],
                    "type": "string"
                  },
                  "project_id": {
                    "type": "string"
                  },
                  "through": {
                    "type": "string"
                  }
                },
                "required": [
                  "event",
                  "project_id",
                  "through"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "event": {
                    "enum": [
                      "review-needed"
                    ],
                    "type": "string"
                  },
                  "merge_request_url": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "event",
                  "merge_request_url",
                  "project_id"
                ],
                "type": "object"
              }
            ]
          }
        },
        "runAfter": {
          "Validate_delivery": [
            "Succeeded"
          ]
        }
      },
      "Claim_receipt": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_commondataserviceforapps",
            "operationId": "CreateRecord",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
          },
          "parameters": {
            "entityName": "cr1d0_acorncallbackreceipts",
            "item/cr1d0_webhookid": "@triggerBody()?['text']",
            "item/cr1d0_emailrecipient": "@if(or(equals(body('Validate_event')?['event'],'mr-created'),equals(body('Validate_event')?['event'],'report-no-changes')),'teams-self:o9w@ornl.gov','o9w@ornl.gov')",
            "item/cr1d0_emailstate": "Pending",
            "item/cr1d0_payloadjson": "@triggerBody()?['text_1']"
          },
          "authentication": {
            "type": "Raw",
            "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
          },
          "retryPolicy": {
            "type": "none"
          }
        },
        "runAfter": {
          "Validate_event": [
            "Succeeded"
          ]
        }
      }
    },
    "runAfter": {}
  }
}
