IfError(Set(varSubmitting, false); If(IsBlank(varPendingJson), Set(varPendingId, Lower(Text(GUID()))); Set(varPendingAt, Text(Now(), DateTimeFormat.UTC)); Set(varPendingJson, JSON({entry: {archived: false, category: CategoryDropdown.Selected.Value, eventType: If(EventTypeDropdown.Selected.Value = "Not specified", Blank(), EventTypeDropdown.Selected.Value), global: PlacementDropdown.Selected.Value = "General update (report title page)", items: If(IsEmpty(Filter(Split(Substitute(ItemsInput.Text, Char(13), ""), Char(10)), !IsBlank(Trim(Value)))), Blank(), ForAll(Filter(Split(Substitute(ItemsInput.Text, Char(13), ""), Char(10)), !IsBlank(Trim(Value))), Trim(Value))), origin: "manual", state: StateDropdown.Selected.Value, summary: Trim(SummaryInput.Text), timestamp: Text(OccurredOnPicker.SelectedDate, DateTimeFormat.UTC)}, projectId: ProjectDropdown.Selected.ProjectId, submissionId: varPendingId, submittedAt: varPendingAt, submitter: {email: Lower(User().Email)}}, JSONFormat.Compact & JSONFormat.FlattenValueTables))); Set(varSubmissionStatus, "Draft prepared for " & ProjectDropdown.Selected.Value & ". Nothing has been sent."); Notify("Draft prepared for " & Left(ProjectDropdown.Selected.Value, 120) & ". Nothing has been sent. Select Edit draft to make changes.", NotificationType.Information, 0), Set(varSubmitting, false); Set(varSubmissionStatus, "We couldn't prepare your highlight. Your entries are still here. Please try again."); Notify(varSubmissionStatus, NotificationType.Error, 0))
