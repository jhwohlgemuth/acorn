{
  "brandColor": "#8C6CFF",
  "connectionReferences": {},
  "connectorDisplayName": "Control",
  "id": "8b7c282a-53aa-4591-87f4-6163bbf600e1",
  "isTrigger": false,
  "operationName": "Notify_confirmed_new_submission",
  "operationDefinition": {
    "type": "If",
    "expression": {
      "equals": [
        "@actions('Queued_new')?['status']",
        "Succeeded"
      ]
    },
    "runAfter": {
      "Unresolved_failure": [
        "Succeeded",
        "Failed",
        "Skipped",
        "TimedOut"
      ]
    },
    "actions": {
      "Post_intake_update_to_Teams": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_teams",
            "operationId": "PostMessageToSelf",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
          },
          "parameters": {
            "body/body/content": "@concat(if(contains(toUpper(body('Parse_submission')?['entry']?['summary']),'TEST ONLY'),'<p><strong>TEST ONLY</strong></p>',''),'<p>ACORN // Sponsor Highlights</p><h2>✓ Highlight saved</h2><p><strong>Project</strong><br>',replace(replace(replace(string(body('Parse_submission')?['projectId']),'&','&amp;'),'<','&lt;'),'>','&gt;'),'</p><p><strong>Status</strong><br>Saved to the logbook · Awaiting ACORN review</p><p><a href=\"https://code.ornl.gov/research-enablement/experiments/power-automate/-/commit/',uriComponent(string(body('Commit_append')?['id'])),'\"><strong>View saved record →</strong></a></p><p><strong>Receipt ID</strong><br><code>',replace(replace(replace(string(body('Parse_submission')?['submissionId']),'&','&amp;'),'<','&lt;'),'>','&gt;'),'</code></p><p><em>Saving does not approve or publish the highlight.</em></p>')",
            "body/body/contentType": "html"
          },
          "authentication": "@parameters('$authentication')",
          "retryPolicy": {
            "type": "none"
          }
        },
        "runAfter": {},
        "runtimeConfiguration": {
          "secureData": {
            "properties": [
              "inputs",
              "outputs"
            ]
          }
        }
      }
    },
    "else": {
      "actions": {}
    }
  }
}
