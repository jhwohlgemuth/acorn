// Rounded pastel boxes and green arrows match the ACORN book.
scale = 1
fontscale = 1.2
color = 0x183C43
S: box "SharePoint app" bold "Standard connectors" wid 2.1in ht 0.85in rad 0.08in fill 0xE8F1FB thickness 0
SL: box "List + logbook.jsonl" bold "Combined: every 5 min" "Teams: new receipt export" same fill 0xE7F3E9 at S+(2.55in,0)
SD: box "Download logbook" bold "All collected rows" "Preserve exact bytes" same fill 0xFFF4D6 at SL+(2.55in,0)
arrow from S.e to SL.w thick color 0x00662C
arrow from SL.e to SD.w thick color 0x00662C
G: box "GitLab app" bold "Custom connector" same fill 0xE8F1FB at S+(0,-1.3in)
GL: box "JSONL logbook" bold "Immutable commit" "Teams: confirmed new save" same fill 0xE7F3E9 at SL+(0,-1.3in)
GD: box "Use GitLab file URL" bold "CLI captures snapshot" same fill 0xFFF4D6 at SD+(0,-1.3in)
arrow from G.e to GL.w thick color 0x00662C
arrow from GL.e to GD.w thick color 0x00662C
Join: line from SD.e right 0.3in then down 2.05in color 0x00662C
line from GD.e right 0.3in color 0x00662C
R: box "Stage + inspect" bold "Review the diff" wid 1.65in ht 0.75in rad 0.08in fill 0xFFF4D6 thickness 0 at S+(0,-2.9in)
A: box "Apply" bold "Confirm intake" same fill 0xE7F3E9 at R+(1.85in,0)
P: box "run --index" bold "Optional promotion" same fill 0xE7F3E9 at A+(1.85in,0)
F: box "Report" bold "Local PDF" same fill 0xF2F2F2 at P+(1.85in,0)
arrow from Join.end left until even with R then down until even with R.n thick color 0x00662C
arrow from R.e to A.w thick color 0x00662C
arrow from A.e to P.w thick color 0x00662C
arrow from P.e to F.w thick color 0x00662C
N: box "OWNER-TRIGGERED MILESTONES" bold "Teams: workspace created / no report changes" "Email: review requested / report ready / actionable failure" wid 7.2in ht 0.85in rad 0.08in fill 0xF3F0FF thickness 0 at A+(0.925in,-1.25in)
arrow from A.s to (A.x,N.n.y) dashed color 0x506A70
arrow from F.s to (F.x,N.n.y) dashed color 0x506A70
