// Match the book's rounded pastel boxes and ORNL green workflow arrows.
scale = 1
fontscale = 1.3
color = 0x183C43
Submit: box "1. Submit highlight" "PowerApp" wid 1.55in ht 0.84in rad 0.08in fill 0xE8F1FB thickness 0
Save: box "2. Save + receipt" "Power Automate" "GitLab JSONL" same fill 0xF3F0FF at Submit+(1.85in,0)
Review: box "3. Review" "Stage + inspect" same fill 0xFFF4D6 at Save+(1.85in,0)
Apply: box "4. Confirm apply" "Add logbook entry" same fill 0xE7F3E9 at Review+(1.85in,0)
Graduate: box "5. Graduate" "Confirm promotion" same fill 0xE7F3E9 at Apply+(1.85in,0)
Report: box "6. Build report" "Local PDF" same fill 0xF2F2F2 at Graduate+(1.85in,0)
arrow from Submit.e to Save.w thick color 0x00662C
arrow from Save.e to Review.w thick color 0x00662C
arrow from Review.e to Apply.w thick color 0x00662C
arrow from Apply.e to Graduate.w thick color 0x00662C
arrow from Graduate.e to Report.w thick color 0x00662C
SavedNotice: box "TEAMS" bold "Highlight saved" "Automatic" wid 1.75in ht 0.88in rad 0.08in fill 0xEEEAF8 thickness 0 at Save+(-0.2in,-1.6in)
WorkspaceNotice: box "TEAMS" bold "Workspace created*" "Owner sends" same at Review+(-0.15in,-1.6in)
ReviewNotice: box "EMAIL" bold "Review requested" "Owner sends" same fill 0xFFF4D6 at Apply+(0.1in,-1.6in)
NoChangesNotice: box "TEAMS" bold "No report changes" "Owner sends" same fill 0xEEEAF8 at Graduate+(0.2in,-1.6in)
ReportNotice: box "EMAIL" bold "Published report ready" "Owner sends" same fill 0xFFF4D6 at Report+(0.4in,-1.6in)
arrow from Save.s down 0.4in then left 0.2in then to SavedNotice.n thick color 0x00662C
arrow from Review.s down 0.50in then to WorkspaceNotice.n dashed color 0x506A70
arrow from Review.s down 0.50in then right 1.95in then to ReviewNotice.n dashed color 0x506A70
arrow from Report.s down 0.50in then left 1.65in then to NoChangesNotice.n dashed color 0x506A70
arrow from Report.s down 0.50in then right 0.4in then to ReportNotice.n dashed color 0x506A70
Failure: box "EMAIL / Actionable failure at any stage / Owner sends" wid 7.7in ht 0.5in rad 0.08in fill 0xFBECE8 thickness 0 at Apply+(0,-2.55in)
