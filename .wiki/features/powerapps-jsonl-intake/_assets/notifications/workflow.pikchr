// Match the book's rounded pastel boxes and ORNL green workflow arrows.
scale = 1
fontscale = 1.3
color = 0x183C43
Submit: box "1. Submit" bold "Highlight in" "PowerApp" wid 1.65in ht 1in rad 0.08in fill 0xE8F1FB thickness 0
Save: box "2. Save" bold "JSONL + receipt" "Power Automate" same fill 0xF3F0FF at Submit+(1.95in,0)
Review: box "3. Review" bold "Stage and inspect" "the entry" same fill 0xFFF4D6 at Save+(1.95in,0)
Apply: box "4. Apply" bold "Confirm adding" "the logbook entry" same fill 0xE7F3E9 at Review+(1.95in,0)
Graduate: box "5. Graduate" bold "Confirm optional" "promotion" same fill 0xE7F3E9 at Apply+(1.95in,0)
Report: box "6. Report" bold "Build the" "local PDF" same fill 0xF2F2F2 at Graduate+(1.95in,0)
arrow from Submit.e to Save.w thick color 0x00662C
arrow from Save.e to Review.w thick color 0x00662C
arrow from Review.e to Apply.w thick color 0x00662C
arrow from Apply.e to Graduate.w thick color 0x00662C
arrow from Graduate.e to Report.w thick color 0x00662C
SavedNotice: box "TEAMS" bold "Highlight" "saved" "Automatic" same fill 0xEEEAF8 at Save+(0,-1.8in)
WorkspaceNotice: box "TEAMS" bold "Workspace" "created*" "Owner sends" same at Review+(0,-1.8in)
ReviewNotice: box "EMAIL" bold "Review" "requested" "Owner sends" same fill 0xFFF4D6 at Apply+(0,-1.8in)
NoChangesNotice: box "TEAMS" bold "No report" "changes" "Owner sends" same fill 0xEEEAF8 at Graduate+(0,-1.8in)
ReportNotice: box "EMAIL" bold "Published report" "ready" "Owner sends" same fill 0xFFF4D6 at Report+(0,-1.8in)
arrow from Save.s to SavedNotice.n thick color 0x00662C
ReviewBranch: line from Review.s down 0.4in dashed color 0x506A70
arrow from ReviewBranch.end to WorkspaceNotice.n dashed color 0x506A70
arrow from ReviewBranch.end right 1.95in then down 0.4in dashed color 0x506A70
ReportBranch: line from Report.s down 0.4in dashed color 0x506A70
arrow from ReportBranch.end to ReportNotice.n dashed color 0x506A70
arrow from ReportBranch.end left 1.95in then down 0.4in dashed color 0x506A70
Failure: box "EMAIL  /  Actionable failure at any stage  /  Owner sends" wid 9.45in ht 0.5in rad 0.08in fill 0xFBECE8 thickness 0 at Apply+(0,-2.7in)
