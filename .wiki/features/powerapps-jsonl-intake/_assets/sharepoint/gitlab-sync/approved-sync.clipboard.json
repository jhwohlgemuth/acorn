                "connectionName": "shared_sharepointonline",
                "operationId": "GetFileContentByPath",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@outputs('Sync_configuration_BETA')?['sharePointSiteUrl']",
                "path": "@concat(concat('/',outputs('Sync_configuration_BETA')?['approvedExportLibrary']),'/',first(body('Receipt_files_BETA'))?['Name'])",
                "inferContentType": false
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "maximumInterval": "PT30S"
              }
            },
            "runAfter": {},
            "runtimeConfiguration": {
              "secureData": {
                "properties": [
                  "inputs",
                  "outputs"
                ]
              }
            }
          },
          "Receipt_object_BETA": {
