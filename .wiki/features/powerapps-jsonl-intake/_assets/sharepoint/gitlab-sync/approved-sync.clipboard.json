              ]
            },
            "runtimeConfiguration": {
              "secureData": {
                "properties": [
                  "inputs",
                  "outputs"
                ]
              }
            }
          },
          "Validate_receipt_shape_BETA": {
            "type": "ParseJson",
            "inputs": {
              "content": "@outputs('Receipt_object_BETA')",
              "schema": {
                "type": "object",
                "properties": {
                  "batchCount": {
                    "type": "integer"
                  },
                  "byteCount": {
                    "type": "integer"
                  },
                  "candidateFingerprint": {
                    "type": "string"
                  },
                  "fileIdentity": {
                    "type": "string"
                  },
                  "fileRevision": {
                    "type": "string"
                  },
