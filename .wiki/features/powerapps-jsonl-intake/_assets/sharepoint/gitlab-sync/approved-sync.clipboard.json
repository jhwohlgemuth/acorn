                "required": [
                  "batchCount",
                  "byteCount",
                  "candidateFingerprint",
                  "fileIdentity",
                  "fileRevision",
                  "lastApprovedBatchId",
                  "lineCount",
                  "runId",
                  "verifiedAtUtc"
                ]
              }
            },
            "runAfter": {
              "Receipt_object_BETA": [
                "Succeeded"
              ]
            },
            "runtimeConfiguration": {
              "secureData": {
                "properties": [
                  "inputs",
                  "outputs"
                ]
              }
            }
          },
          "Read_export_metadata_before_BETA": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "HttpRequest",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@outputs('Sync_configuration_BETA')?['sharePointSiteUrl']",
                "parameters/method": "GET",
                "parameters/uri": "@concat('_api/web/GetFileByServerRelativeUrl(',decodeUriComponent('%27'),concat(uriPath(outputs('Sync_configuration_BETA')?['sharePointSiteUrl']),'/',outputs('Sync_configuration_BETA')?['approvedExportLibrary'],'/', 'logbook.jsonl'),decodeUriComponent('%27'),')?$select=ETag,UniqueId')",
                "parameters/headers": {
