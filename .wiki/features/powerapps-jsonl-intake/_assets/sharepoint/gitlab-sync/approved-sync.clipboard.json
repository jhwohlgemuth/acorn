                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "maximumInterval": "PT30S"
                  }
                },
                "runAfter": {},
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                }
              },
              "GitLab_read_outcome_BETA": {
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@actions('Read_GitLab_before_BETA')?['status']",
                        "Succeeded"
                      ]
                    },
                    {
                      "equals": [
                        "@body('Read_GitLab_before_BETA')?['encoding']",
                        "base64"
                      ]
                    },
                    {
                      "equals": [
                        "@body('Read_GitLab_before_BETA')?['file_path']",
                        "@outputs('Sync_configuration_BETA')?['approvedGitLabPath']"
                      ]
                    },
                    {
