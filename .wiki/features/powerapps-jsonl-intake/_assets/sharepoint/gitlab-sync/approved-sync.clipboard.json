                      }
                    },
                    {
                      "equals": [
                        "@base64(take(base64ToString(body('Read_approved_export_BETA')?['$content']),length(base64ToString(replace(replace(body('Read_GitLab_before_BETA')?['content'],decodeUriComponent('%0A'),''),decodeUriComponent('%0D'),'')))))",
                        "@replace(replace(body('Read_GitLab_before_BETA')?['content'],decodeUriComponent('%0A'),''),decodeUriComponent('%0D'),'')"
                      ]
                    },
                    {
                      "or": [
                        {
                          "equals": [
                            "@replace(replace(body('Read_GitLab_before_BETA')?['content'],decodeUriComponent('%0A'),''),decodeUriComponent('%0D'),'')",
                            ""
                          ]
                        },
                        {
                          "equals": [
                            "@endsWith(base64ToString(replace(replace(body('Read_GitLab_before_BETA')?['content'],decodeUriComponent('%0A'),''),decodeUriComponent('%0D'),'')),decodeUriComponent('%0A'))",
                            true
                          ]
                        }
                      ]
                    }
                  ]
                },
                "actions": {
                  "Create_or_update_GitLab_BETA": {
                    "type": "If",
                    "expression": {
                      "equals": [
