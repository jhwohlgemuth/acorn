          "type": "Compose",
          "inputs": "@toLower(if(not(empty(triggerOutputs()?['headers']?['x-ms-user-email-encoded'])),base64ToString(triggerOutputs()?['headers']?['x-ms-user-email-encoded']),coalesce(triggerOutputs()?['headers']?['x-ms-user-email'],'')))",
          "runAfter": {},
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        },
        "Read_reviewers": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "https://ornl.sharepoint.com/sites/ResearchEnablement",
              "parameters/method": "GET",
              "parameters/uri": "_api/web/sitegroups/getbyid(42)/users",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata"
              }
            },
            "authentication": "@parameters('$authentication')"
