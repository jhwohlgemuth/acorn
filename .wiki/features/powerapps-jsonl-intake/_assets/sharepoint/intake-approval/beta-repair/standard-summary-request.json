          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Caller_membership": {
          "type": "Query",
          "inputs": {
            "from": "@body('Read_reviewers')?['value']",
            "where": "@equals(toLower(item()?['LoginName']),concat('i:0#.f|membership|',outputs('Caller_email')))"
