              }
            },
            "Wait_for_summary": {
              "type": "Until",
              "expression": "@not(empty(body('Read_result')?['ResponseJson']))",
              "limit": {
                "count": 18,
                "timeout": "PT95S"
              },
              "actions": {
                "Wait": {
                  "type": "Wait",
                  "inputs": {
                    "interval": {
                      "count": 5,
                      "unit": "Second"
                    }
                  },
                  "runAfter": {}
                },
                "Read_result": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItem"
                    },
                    "parameters": {
                      "dataset": "https://ornl.sharepoint.com/sites/ResearchEnablement",
                      "table": "442cdec0-52b9-4f24-97b6-092961312c41",
                      "id": "@body('Create_request')?['ID']"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
