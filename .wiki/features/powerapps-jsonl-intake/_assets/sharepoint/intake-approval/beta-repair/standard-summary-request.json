          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        },
        "Authorized_request": {
          "type": "If",
          "expression": {
            "equals": [
              "@and(not(empty(outputs('Caller_email'))),equals(length(body('Caller_membership')),1),greater(length(trim(coalesce(triggerBody()?['text'],''))),0),lessOrEquals(length(coalesce(triggerBody()?['text'],'')),12000))",
              true
            ]
          },
          "actions": {
