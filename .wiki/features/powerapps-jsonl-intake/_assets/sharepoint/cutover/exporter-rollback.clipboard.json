          ]
        },
        "metadata": {
          "operationMetadataId": "9e33d526-3770-4098-baa2-cc57f4399d88"
        },
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItems"
          },
          "parameters": {
            "dataset": "https://ornl.sharepoint.com/sites/ResearchEnablement",
            "table": "a904a6c6-5dd0-427b-9575-8167c4c0c412",
            "$filter": "@concat('ID le ', string(outputs('High_water_item_LB')))",
            "$orderby": "ID asc",
            "$top": 5001
          },
          "retryPolicy": {
            "type": "none"
          },
          "authentication": "@parameters('$authentication')"
        },
        "runtimeConfiguration": {
          "paginationPolicy": {
