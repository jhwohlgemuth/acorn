          ]
        },
        "metadata": {
          "operationMetadataId": "258b3ecd-a9d9-475c-970c-557306957c2f"
        },
        "type": "Query",
        "inputs": {
          "from": "@body('Read_receipts_LB')?['value']",
          "where": "@or(empty(item()?['SubmissionId']), empty(item()?['PayloadBase64A']), contains(base64ToString(concat(item()?['PayloadBase64A'], coalesce(item()?['PayloadBase64B'], string(null)))), decodeUriComponent('%0A')), contains(base64ToString(concat(item()?['PayloadBase64A'], coalesce(item()?['PayloadBase64B'], string(null)))), decodeUriComponent('%0D')), not(equals(json(base64ToString(concat(item()?['PayloadBase64A'], coalesce(item()?['PayloadBase64B'], string(null)))))?['submissionId'], item()?['SubmissionId'])), not(equals(json(base64ToString(concat(item()?['PayloadBase64A'], coalesce(item()?['PayloadBase64B'], string(null)))))?['projectId'], item()?['ProjectId'])))"
        },
        "runtimeConfiguration": {
          "secureData": {
            "properties": [
              "inputs",
              "outputs"
            ]
          }
        }
      },
      "Complete_valid_rows_LB": {
        "actions": {
          "Select_original_rows_LB": {
            "runAfter": {},
            "metadata": {
              "operationMetadataId": "d4a92184-42c8-4727-8e27-e3fb7bcb98b6"
            },
            "type": "Select",
            "inputs": {
              "from": "@body('Read_receipts_LB')?['value']",
              "select": "@base64ToString(concat(item()?['PayloadBase64A'], coalesce(item()?['PayloadBase64B'], string(null))))"
            },
            "runtimeConfiguration": {
              "secureData": {
                "properties": [
                  "inputs",
                  "outputs"
                ]
              }
            }
          },
          "Combined_JSONL_LB": {
            "runAfter": {
              "Select_original_rows_LB": [
                "Succeeded"
              ]
            },
            "metadata": {
              "operationMetadataId": "be08ab31-d654-45b0-8adc-0f5c0f72aa5a"
            },
            "type": "Compose",
            "inputs": "@if(empty(body('Select_original_rows_LB')), string(null), concat(join(body('Select_original_rows_LB'), decodeUriComponent('%0A')), decodeUriComponent('%0A')))",
            "runtimeConfiguration": {
              "secureData": {
                "properties": [
                  "inputs"
                ]
              }
            }
          },
          "Within_byte_limit_LB": {
            "actions": {
              "Read_previous_logbook_LB": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "fcead0ea-7791-4aad-ae7a-54a94567dd90"
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "GetFileContentByPath"
                  },
                  "parameters": {
                    "dataset": "https://ornl.sharepoint.com/sites/ResearchEnablement",
                    "path": "/Sponsor Highlights JSONL Pilot/logbook.jsonl",
                    "inferContentType": false
                  },
                  "retryPolicy": {
                    "type": "none"
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                }
              },
              "Changed_logbook_LB": {
                "actions": {
                  "Write_logbook_LB": {
                    "runAfter": {},
                    "metadata": {
                      "operationMetadataId": "8e09a19a-f56a-4e99-9a5d-c6b27e489bc1"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "HttpRequest"
                      },
                      "parameters": {
                        "dataset": "https://ornl.sharepoint.com/sites/ResearchEnablement",
                        "parameters/method": "POST",
                        "parameters/uri": "_api/web/GetFolderByServerRelativeUrl('/sites/ResearchEnablement/Sponsor Highlights JSONL Pilot')/Files/add(url='logbook.jsonl',overwrite=true)",
                        "parameters/headers": {
                          "Accept": "application/json;odata=nometadata",
                          "Content-Type": "application/octet-stream"
                        },
                        "parameters/body": "@outputs('Combined_JSONL_LB')"
                      },
                      "retryPolicy": {
                        "type": "none"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runtimeConfiguration": {
                      "secureData": {
                        "properties": [
                          "inputs",
                          "outputs"
                        ]
                      }
                    }
                  }
                },
                "runAfter": {
                  "Read_previous_logbook_LB": [
                    "Succeeded",
                    "Failed",
                    "Skipped",
                    "TimedOut"
                  ]
                },
                "expression": {
                  "not": {
                    "equals": [
                      "@body('Read_previous_logbook_LB')?['$content']",
                      "@base64(outputs('Combined_JSONL_LB'))"
                    ]
                  }
                },
                "metadata": {
                  "operationMetadataId": "7db12b4b-630d-48be-b732-ab758373a282"
                },
                "type": "If"
              },
              "Read_published_logbook_LB": {
                "runAfter": {
                  "Changed_logbook_LB": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "061681c6-b3eb-4785-bb98-de63f982e0b7"
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "GetFileContentByPath"
                  },
                  "parameters": {
                    "dataset": "https://ornl.sharepoint.com/sites/ResearchEnablement",
                    "path": "/Sponsor Highlights JSONL Pilot/logbook.jsonl",
                    "inferContentType": false
                  },
                  "retryPolicy": {
                    "type": "none"
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                }
              },
              "Exact_logbook_LB": {
                "actions": {
                  "Export_receipt_LB": {
                    "runAfter": {},
                    "metadata": {
                      "operationMetadataId": "48457767-4780-477a-8c63-d8afab5173af"
                    },
                    "type": "Compose",
                    "inputs": {
                      "rows": "@length(body('Read_receipts_LB')?['value'])",
                      "highWaterItemId": "@outputs('High_water_item_LB')",
                      "verifiedAt": "@utcNow()",
                      "url": "https://ornl.sharepoint.com/sites/ResearchEnablement/Sponsor%20Highlights%20JSONL%20Pilot/logbook.jsonl"
                    }
                  }
                },
                "runAfter": {
                  "Read_published_logbook_LB": [
                    "Succeeded"
                  ]
                },
                "else": {
                  "actions": {
                    "LogbookReadbackMismatch": {
                      "runAfter": {},
                      "metadata": {
                        "operationMetadataId": "a0d95e99-d2e3-4725-b633-4f69fad37331"
                      },
                      "type": "Terminate",
                      "inputs": {
                        "runStatus": "Failed",
                        "runError": {
                          "code": "LogbookReadbackMismatch",
                          "message": "Combined logbook readback did not match the exact source rows."
                        }
                      }
                    }
                  }
                },
                "expression": {
                  "equals": [
                    "@body('Read_published_logbook_LB')?['$content']",
                    "@base64(outputs('Combined_JSONL_LB'))"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "25d7ecea-dd28-4c28-a92f-eb286c9eeaa3"
                },
                "type": "If"
              }
            },
            "runAfter": {
              "Combined_JSONL_LB": [
                "Succeeded"
              ]
            },
            "else": {
              "actions": {
                "LogbookTooLarge": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "c0323693-10f2-461c-8aef-8aa82413ab2b"
                  },
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "LogbookTooLarge",
                      "message": "Export exceeds the 10 MiB ACORN source limit; previous logbook retained."
                    }
                  }
                }
              }
            },
            "expression": {
              "lessOrEquals": [
                "@sub(div(mul(length(base64(outputs('Combined_JSONL_LB'))), 3), 4), if(endsWith(base64(outputs('Combined_JSONL_LB')), '=='), 2, if(endsWith(base64(outputs('Combined_JSONL_LB')), '='), 1, 0)))",
                10485760
              ]
            },
            "metadata": {
              "operationMetadataId": "f4d8b37b-cedd-4228-90a9-924fddea5a25"
            },
            "type": "If"
          }
        },
        "runAfter": {
          "Invalid_rows_LB": [
            "Succeeded"
          ]
        },
        "else": {
          "actions": {
            "LogbookInvalidOrTruncated": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "3a8defbb-b928-41ea-9500-b5bc708ac0ac"
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "LogbookInvalidOrTruncated",
                  "message": "Receipt limit or invalid stored payload; previous logbook retained."
                }
              }
            }
          }
        },
        "expression": {
          "and": [
            {
              "lessOrEquals": [
                "@length(body('Read_receipts_LB')?['value'])",
                5000
              ]
            },
            {
              "equals": [
                "@length(body('Invalid_rows_LB'))",
                0
              ]
            }
          ]
        },
        "metadata": {
          "operationMetadataId": "0bfe40f8-0f00-40ff-bdeb-7c78c0e1c863"
        },
        "type": "If"
      }
    },
    "runAfter": {},
    "metadata": {
