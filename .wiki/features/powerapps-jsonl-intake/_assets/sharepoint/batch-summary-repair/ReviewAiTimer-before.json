      "InvariantScript": "If(varSummaryIndex>0 && varSummaryIndex<=CountRows(colReviewDrafts),With({item:Last(FirstN(colReviewDrafts,varSummaryIndex)),generationAtStart:varSummaryGeneration},If(LookUp(colReviewAiSummaries,id=item.id).state=\"queued\",With({content:Trim(\"Report page: \" & If(item.projectId=\"general\",\"General Updates\",item.projectId) & Char(10) & \"Entry type: \" & item.kind & Char(10) & \"Report structure: For an activity, write a concise factual summary followed by supporting activities and date or status. For project status, lead with project health and significance, then evidence, risks, and reporting period. Use only the submitted facts. State uncertainty or omissions plainly; do not invent outcomes.\" & Char(10) & \"Source summary: \" & item.sourceSummary & Char(10) & \"Supporting activities: \" & item.sourceItems & Char(10) & \"Submitted details: \" & item.sourceDetails)},If(Len(content)>12000,UpdateIf(colReviewAiSummaries,id=item.id,{state:\"too-long\"}),IfError(With({response:'[BETA]RequestReviewerSummary'.Run(content)},With({suggestion:Trim(response.summary)},UpdateIf(colReviewAiSummaries,id=item.id,{summary:suggestion,state:If(!IsBlank(suggestion) && Len(suggestion)<=1200,\"ready\",\"invalid\")}))),UpdateIf(colReviewAiSummaries,id=item.id,{state:\"error\"}))))); If(generationAtStart=varSummaryGeneration,Set(varSummaryIndex,varSummaryIndex+1))))",
