Set(varProjectsLoading, true); Set(varProjectCatalogError, ""); Set(varCatalogLoaded, false); ClearCollect(colProjects, {Value: "Select a project", ProjectId: ""}); IfError(Set(varProjectCatalogResponse, ACORNProjectCatalog.Run()); Collect(colProjects, ForAll(Table(ParseJSON(varProjectCatalogResponse.catalog).projects), {Value: Text(ThisRecord.Value.label), ProjectId: Text(ThisRecord.Value.id)})); Set(varCatalogLoaded, true), ClearCollect(colProjects, {Value: "Select a project", ProjectId: ""}); Set(varProjectCatalogError, "Projects could not be loaded. Please try Refresh projects.")); Set(varProjectsLoading, false); Reset(ProjectDropdown)