  "title": "RAD validation workshop: intentionally flawed metadata",
  "sections": {
    "mission": "Explain how seasonal rainfall and land use shape water availability across connected watersheds.",
    "challenge": "Field teams collect different measurements on different schedules, making regional comparisons difficult.",
    "approach": [
      " ",
      "Combine field observations with reproducible watershed simulations."
    ],
    "impact": [
      "Help field teams compare seasonal water availability across connected watersheds."
    ],
    "research": {
      "focus": "Reproducible watershed observation and analysis",
      "areas": [
        "Environmental observations",
        "Uncertainty quantification",
        "Research data management"
      ]
    },
    "achievement": [
      "Released three quality-controlled seasonal observation datasets.",
      "Reproduced the processing workflow on CPU and GPU environments."
    ],
    "capabilities": [
      "Field calibration, automated quality control, uncertainty propagation and geospatial visualization."
    ]
  },
