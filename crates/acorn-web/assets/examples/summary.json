  "title": "Mapping Seasonal Watershed Changes",
  "sections": {
    "mission": "Explain how seasonal rainfall and land use shape water availability across connected watersheds.",
    "challenge": "Field teams collect different measurements on different schedules, making regional comparisons difficult.",
    "approach": [
      "Collect hourly observations at paired upstream and downstream stations.",
      "Calibrate instruments against reference measurements before each field campaign.",
      "Publish versioned data, uncertainty estimates and executable processing workflows.",
      "Compare seasonal patterns with an independently collected validation dataset."
    ],
    "impact": [
      "Make water-quality trends comparable across instruments and locations.",
      "Help researchers reproduce analyses using documented data and software versions.",
      "Provide reusable teaching materials with transparent measurement uncertainty."
    ],
    "research": {
      "focus": "Reproducible watershed observation and analysis",
      "areas": [
        "Environmental observations",
        "Uncertainty quantification",
        "Research data management"
      ]
    },
    "achievement": [
      "Released three quality-controlled seasonal observation datasets.",
      "Reproduced the processing workflow on CPU and GPU environments."
    ],
    "capabilities": [
      "Field calibration, automated quality control, uncertainty propagation and geospatial visualization."
    ]
  },
