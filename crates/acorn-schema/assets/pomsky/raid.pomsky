let a = ['aA'];
let d = ['dD'];
let h = ['hH'];
let i = ['iI'];
let g = ['gG'];
let o = ['oO'];
let p = ['pP'];
let r = ['rR'];
let s = ['sS'];
let t = ['tT'];
let org = o r g;

(regex '(?<schema_uri>' h t t p s '://' r a i d '.' org '/' regex ')')?
regex '(?<directory_indicator>' '10' regex ')' '.'
regex '(?<registrant_code>' [d]{4,9} regex ')' '/'
:suffix(['-._;()/:' 'a'-'z' 'A'-'Z' '0'-'9']+)
