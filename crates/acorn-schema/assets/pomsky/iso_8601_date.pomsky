^ :year(:(
    '19' ['5'-'9'] [d]
  | '20' ['0'-'2'] [d]
)) '-'
:month(:(
    :('0' ['13578'] | :('10' | '12')) '-' :day(:(
        '0' ['1'-'9']
      | ['1'-'2'] [d]
      | '3' ['0'-'1']
    ))
  | :('02' '-' :(
        '0' ['1'-'9']
      | ['1'-'2'] [d]
    ))
  | :( :('0' ['469'] | '11') '-' :(
        '0' ['1'-'9']
      | ['1'-'2'] [d]
      | '30'
    ))
)) $
