let isbn = ['iI'] ['sS'] ['bB'] ['nN'];
let urn = ['uU'] ['rR'] ['nN'];

(!<< ['a'-'z' 'A'-'Z' '0'-'9'])
(urn ':' isbn ':')?
(
    '97' ['89'] [' -']? [d]{1,5} [' -']? [d]{1,7} [' -']? [d]{1,6} [' -']? [d]
  | (
        '999' [d]{2}
      | '99' ['0'-'8'] [d]
      | '9' ['5'-'8'] [d]
      | '8' [d]
      | '9' ['0'-'4']
      | ['0'-'5']
      | '7'
    ) [' -'] [d]{1,7} [' -'] [d]{1,6} [' -'] ['0'-'9' 'Xx']
  | [d]{9} ['0'-'9' 'Xx']
)
(!>> ['a'-'z' 'A'-'Z' '0'-'9'])
