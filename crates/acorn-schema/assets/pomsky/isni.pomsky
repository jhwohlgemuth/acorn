let isni = ['iI'] ['sS'] ['nN'] ['iI'];

(!<< ['a'-'z' 'A'-'Z' '0'-'9'])
(isni ([' ' t]* ':' [' ' t]* | [' ' t]+))?
(regex '(?<schema_uri>' 'http' 's'? '://' 'isni.org/isni/' regex ')')?
:identifier(
    ['0'-'9']{4} [' -']?
    ['0'-'9']{4} [' -']?
    ['0'-'9']{4} [' -']?
    ['0'-'9']{3}
    regex '(?<check_digit>' ['0'-'9' 'X'] regex ')'
)
(!>> ['a'-'z' 'A'-'Z' '0'-'9'])
