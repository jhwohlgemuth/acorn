FROM ubuntu
#
# %labels
#
LABEL author="Jason Wohlgemuth"
#
# %arguments
#
ARG ACORN_VERSION=0.1.42
ARG DEBIAN_FRONTEND=noninteractive
ARG DEFAULT_TARGET=x86_64-unknown-linux-musl
ARG VALE_VERSION=3.13.0
#
# %post
#
RUN apt-get update && apt-get install --no-install-recommends --yes \
        ca-certificates \
        curl \
        git-lfs \
        gnupg \
        npm \
    && git config --global http.sslVerify false \
    && mkdir -p /etc/apt/keyrings \
    && curl -k -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install --no-install-recommends --yes \
        nodejs \
    && npx playwright install-deps \
    && curl -L "https://github.com/errata-ai/vale/releases/download/v${VALE_VERSION}/vale_${VALE_VERSION}_Linux_64-bit.tar.gz" -o /root/vale.tar.gz \
    && tar -xvzf /root/vale.tar.gz -C /bin \
    && curl -L "http://code.ornl.gov/api/v4/projects/16689/packages/generic/${DEFAULT_TARGET}/v${ACORN_VERSION}/acorn" -o /usr/local/bin/acorn \
    && chmod +x /usr/local/bin/acorn \
    && apt-get clean \
    && rm -rf /tmp/* /var/lib/apt/lists/* /var/tmp/* \
    && rm -rf /usr/share/man/?? \
    && rm -rf /usr/share/man/??_*
HEALTHCHECK NONE
CMD ["/bin/bash"]