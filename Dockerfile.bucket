ARG DOCKER_HUB_REGISTRY=docker.io/library
ARG ACORN_IMAGE=acorn:latest
FROM ${ACORN_IMAGE} AS acorn-binary
FROM ${DOCKER_HUB_REGISTRY}/ubuntu:noble
#
# %labels
#
LABEL author="Jason Wohlgemuth"
#
# %arguments
#
ARG DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH
ARG VALE_VERSION=3.13.0
#
# %post
#
RUN case "${TARGETARCH}" in \
        amd64) vale_arch=64-bit ;; \
        arm64) vale_arch=arm64 ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && apt-get update && apt-get install --no-install-recommends --yes \
        ca-certificates \
        curl \
        git-lfs \
        gnupg \
        npm \
    && git config --global http.sslVerify false \
    && mkdir -p /etc/apt/keyrings \
    && curl -k -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install --no-install-recommends --yes \
        nodejs \
    && npx playwright install-deps \
    && curl -fL "https://github.com/errata-ai/vale/releases/download/v${VALE_VERSION}/vale_${VALE_VERSION}_Linux_${vale_arch}.tar.gz" -o /root/vale.tar.gz \
    && tar -xvzf /root/vale.tar.gz -C /bin \
    && apt-get clean \
    && rm -rf /tmp/* /var/lib/apt/lists/* /var/tmp/* \
    && rm -rf /usr/share/man/?? \
    && rm -rf /usr/share/man/??_*
COPY --from=acorn-binary /acorn /usr/local/bin/acorn
HEALTHCHECK NONE
CMD ["/bin/bash"]
