FROM ubuntu:noble
#
# %labels
#
LABEL author="Jason Wohlgemuth"
#
# %arguments
#
ARG ACORN_VERSION=0.1.50
ARG DEBIAN_FRONTEND=noninteractive
ARG DEFAULT_TARGET=x86_64-unknown-linux-musl
ARG VALE_VERSION=3.13.0
#
# %post
#
RUN apt-get update && apt-get install --no-install-recommends --yes \
        ca-certificates \
        curl \
        git-lfs \
        gnupg \
    && git config --global http.sslVerify false \
    && curl -L "https://github.com/errata-ai/vale/releases/download/v${VALE_VERSION}/vale_${VALE_VERSION}_Linux_64-bit.tar.gz" -o /root/vale.tar.gz \
    && tar -xvzf /root/vale.tar.gz -C /bin \
    && curl -L "http://code.ornl.gov/api/v4/projects/16689/packages/generic/${DEFAULT_TARGET}/v${ACORN_VERSION}/acorn" -o /usr/local/bin/acorn \
    && chmod +x /usr/local/bin/acorn \
    && apt-get clean \
    && rm -rf /tmp/* /var/lib/apt/lists/* /var/tmp/* \
    && rm -rf /usr/share/man/?? \
    && rm -rf /usr/share/man/??_*
HEALTHCHECK NONE
CMD ["/bin/bash"]