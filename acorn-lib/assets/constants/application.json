{
  "endpoints": [
    {
      "name": "citeas",
      "domain": "api.citeas.org",
      "resources": [
        {
          "name": "record",
          "method": "get",
          "template": "{{ base }}/product/{{ doi }}?email=research@ornl.gov"
        },
        {
          "name": "status",
          "method": "get",
          "template": "{{ base }}/?email=research@ornl.gov"
        }
      ]
    },
    {
      "name": "geonames",
      "domain": "download.geonames.org",
      "resources": [
        {
          "name": "countries",
          "method": "get",
          "template": "{{ base }}/export/dump/countryInfo.txt"
        }
      ]
    },
    {
      "name": "github::api",
      "domain": "api.github.com",
      "resources": [
        {
          "name": "tree",
          "method": "get",
          "template": "{{ base }}/repos/{{ path }}/git/trees/{{ branch }}{{ query }}"
        }
      ]
    },
    {
      "name": "github::org",
      "domain": "raw.githubusercontent.com",
      "root": "github-linguist/linguist",
      "resources": [
        {
          "name": "languages",
          "method": "get",
          "template": "{{ base }}/refs/heads/main/lib/linguist/languages.yml"
        }
      ]
    },
    {
      "name": "huggingface::api",
      "domain": "huggingface.co",
      "root": "api",
      "resources": [
        {
          "name": "tree",
          "method": "get",
          "template": "{{ base }}/models/{{ identifier }}/tree/{{ revision }}{{ query }}"
        }
      ]
    },
    {
      "name": "gitlab::api",
      "domain": "gitlab.com",
      "root": "api/v4",
      "resources": [
        {
          "name": "events",
          "method": "get",
          "template": "{{ base }}/projects/{{ identifier }}/events{{ query }}"
        },
        {
          "name": "group",
          "method": "get",
          "template": "{{ base }}/groups/{{ identifier }}{{ query }}"
        },
        {
          "name": "groups",
          "method": "get",
          "template": "{{ base }}/groups/{{ identifier }}/descendant_groups{{ query }}"
        },
        {
          "name": "hooks",
          "method": "get",
          "template": "{{ base }}/projects/{{ identifier }}/hooks{{ query }}"
        },
        {
          "name": "hook::create",
          "method": "post",
          "template": "{{ base }}/projects/{{ identifier }}/hooks"
        },
        {
          "name": "hook::update",
          "method": "put",
          "template": "{{ base }}/projects/{{ identifier }}/hooks/{{ hook_id }}"
        },
        {
          "name": "jobs",
          "method": "get",
          "template": "{{ base }}/runners/{{ identifier }}/jobs{{ query }}"
        },
        {
          "name": "languages",
          "method": "get",
          "template": "{{ base }}/projects/{{ identifier }}/languages{{ query }}"
        },
        {
          "name": "merge-request-note",
          "method": "post",
          "template": "{{ base }}/projects/{{ identifier }}/merge_requests/{{ internal_identifier }}/notes"
        },
        {
          "name": "merge-request-note::update",
          "method": "put",
          "template": "{{ base }}/projects/{{ identifier }}/merge_requests/{{ internal_identifier }}/notes/{{ note_id }}"
        },
        {
          "name": "merge-request-notes",
          "method": "get",
          "template": "{{ base }}/projects/{{ identifier }}/merge_requests/{{ internal_identifier }}/notes{{ query }}"
        },
        {
          "name": "merge-request-diffs",
          "method": "get",
          "template": "{{ base }}/projects/{{ identifier }}/merge_requests/{{ internal_identifier }}/diffs{{ query }}"
        },
        {
          "name": "merge-requests",
          "method": "get",
          "template": "{{ base }}/projects/{{ identifier }}/merge_requests/{{ internal_identifier }}{{ query }}"
        },
        {
          "name": "repository-file",
          "method": "get",
          "template": "{{ base }}/projects/{{ identifier }}/repository/files/{{ file_path }}{{ query }}"
        },
        {
          "name": "commit-status",
          "method": "post",
          "template": "{{ base }}/projects/{{ identifier }}/statuses/{{ sha }}"
        },
        {
          "name": "current-user",
          "method": "get",
          "template": "{{ base }}/user"
        },
        {
          "name": "projects",
          "method": "get",
          "template": "{{ base }}/projects/{{ identifier }}{{ query }}"
        },
        {
          "name": "releases",
          "method": "get",
          "template": "{{ base }}/projects/{{ identifier }}/releases{{ query }}"
        },
        {
          "name": "runner",
          "method": "get",
          "template": "{{ base }}/runners/{{ identifier }}{{ query }}"
        },
        {
          "name": "runner::create",
          "method": "post",
          "template": "{{ base }}/user/runners{{ query }}"
        },
        {
          "name": "runners",
          "method": "get",
          "template": "{{ base }}/runners{{ query }}"
        },
        {
          "name": "tags",
          "method": "get",
          "template": "{{ base }}/projects/{{ identifier }}/repository/tags{{ query }}"
        },
        {
          "name": "tree",
          "method": "get",
          "template": "{{ base }}/projects/{{ identifier }}/repository/tree{{ query }}"
        },
        {
          "name": "version",
          "method": "get",
          "template": "{{ base }}/version"
        }
      ]
    },
    {
      "name": "gitlab::org",
      "domain": "gitlab.com",
      "root": "gitlab-org/gitlab",
      "resources": [
        {
          "name": "languages",
          "method": "get",
          "template": "{{ base }}/-/raw/master/vendor/languages.yml"
        }
      ]
    },
    {
      "name": "openai::api",
      "domain": "api.openai.com",
      "root": "v1",
      "resources": [
        {
          "name": "completion",
          "method": "post",
          "template": "{{ base }}/completions"
        },
        {
          "name": "chat-completion",
          "method": "post",
          "template": "{{ base }}/chat/completions"
        },
        {
          "name": "models",
          "method": "get",
          "template": "{{ base }}/models{{ query }}"
        },
        {
          "name": "response",
          "method": "post",
          "template": "{{ base }}/responses"
        },
        {
          "name": "embedding",
          "method": "post",
          "template": "{{ base }}/embeddings"
        },
        {
          "name": "audio-speech",
          "method": "post",
          "template": "{{ base }}/audio/speech"
        },
        {
          "name": "audio-transcription",
          "method": "post",
          "template": "{{ base }}/audio/transcriptions"
        },
        {
          "name": "audio-voices",
          "method": "get",
          "template": "{{ base }}/audio/voices{{ query }}"
        },
        {
          "name": "image-generation",
          "method": "post",
          "template": "{{ base }}/images/generations"
        },
        {
          "name": "image-edit",
          "method": "post",
          "template": "{{ base }}/images/edits"
        }
      ]
    },
    {
      "name": "orcid",
      "domain": "pub.orcid.org",
      "root": "v3.0",
      "resources": [
        {
          "name": "search",
          "method": "get",
          "template": "{{ base }}/expanded-search/{{ query }}"
        },
        {
          "name": "status",
          "method": "get",
          "template": "{{ base }}/pubStatus"
        }
      ]
    },
    {
      "name": "raid::api",
      "domain": "api.demo.raid.org.au",
      "resources": [
        {
          "name": "record",
          "method": "get",
          "template": "{{ base }}/raid/{{ identifier }}{{ query }}"
        },
        {
          "name": "record::create",
          "method": "post",
          "template": "{{ base }}/raid/"
        },
        {
          "name": "service-point",
          "method": "get",
          "template": "{{ base }}/service-point/{{ identifier }}{{ query }}"
        }
      ]
    },
    {
      "name": "ror",
      "domain": "api.ror.org",
      "root": "v2",
      "resources": [
        {
          "name": "search",
          "method": "get",
          "template": "{{ base }}/organizations/{{ identifier }}{{ query }}"
        },
        {
          "name": "status",
          "method": "get",
          "template": "{{ base }}/heartbeat"
        }
      ]
    },
    {
      "name": "spdx",
      "domain": "spdx.org",
      "resources": [
        {
          "name": "licenses",
          "method": "get",
          "template": "{{ base }}/licenses/licenses.json"
        }
      ]
    },
    {
      "name": "models-dev",
      "domain": "models.dev",
      "resources": [
        {
          "name": "catalog",
          "method": "get",
          "template": "{{ base }}/catalog.json"
        }
      ]
    }
  ]
}
